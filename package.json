{
  "name": "dsh-codearts-dock",
  "version": "1.2.0",
  "displayName": "CodeArts Dock · 码道驿站",
  "description": "为 DeepSeek Harness 接入华为云码道模型的非官方插件，提供多账号、积分概览、模型预设与加密配置备份。",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "main": "dist/index.js",
  "icon": "icons/dsh-codearts-dock-128.png",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icons",
    "test",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "DISCLAIMER.md",
    "SECURITY.md",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "codearts",
    "huawei-cloud",
    "madao",
    "model-provider",
    "llm-adapter",
    "sm4-gcm",
    "huawei-signature",
    "ai-coding-agent"
  ],
  "license": "MIT",
  "scripts": {
    "test": "npm run check:legal && node scripts/test.mjs",
    "test:live": "node --no-warnings test/live-probe.mjs",
    "check:legal": "bash scripts/check-legal.sh",
    "check:release": "npm run build && node scripts/check-release.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "release:prepare": "node scripts/release.mjs",
    "release:repin": "node scripts/release.mjs --repin",
    "prepare": "husky",
    "prepublishOnly": "npm test && npm run check:release",
    "prepack": "npm run build"
  },
  "author": "Jensen0925",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "husky": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jensen0925/dsh-codearts-dock.git"
  },
  "homepage": "https://github.com/Jensen0925/dsh-codearts-dock#readme",
  "bugs": {
    "url": "https://github.com/Jensen0925/dsh-codearts-dock/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
