# Generated install and build artifacts. pnpm-lock.yaml is the committed source of truth.
node_modules/
dist/
package-lock.json
*.tgz

# Local credentials are never committed. The plugin reads them from
# ~/.config/dsh-codearts-dock/credentials.json (or the environment), not
# from the checkout, so nothing here should ever hold a key.
credentials.json
credentials.enc

# Editor and OS noise
.DS_Store
*.log
.idea/
.vscode/
